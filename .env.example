# --- Analyse-Strategie ---------------------------------------------------
# Aktuell implementiert: isochrone-intersection
ANALYSIS_STRATEGY=isochrone-intersection

# --- Provider ------------------------------------------------------------
# Adresssuche. Unterstuetzt: photon, openrouteservice.
# Photon ist die Vorgabe, weil es messbar genauer ist: auf 13 ungenauen
# Eingaben (Tippfehler, "ss" statt Eszett, Ortsteil statt Gemeinde) fand es 12
# auf Platz 1, der Pelias von ORS nur 3 -- und dessen Index ist Monate alt.
GEOCODING_PROVIDER=photon

# Zweiter Anbieter, falls der erste *nicht antwortet* (Netzfehler, Limit).
# Bei leerem Ergebnis springt er bewusst nicht ein: Ein Anbieter, der nichts
# findet, hat geantwortet, und die zweite Meinung waere hier der
# Strassenmittelpunkt statt des Hauses. "none" schaltet den Rueckfall ab.
GEOCODING_FALLBACK_PROVIDER=openrouteservice

ISOCHRONE_PROVIDER=openrouteservice

# API-Key fuer OpenRouteService: https://openrouteservice.org/dev/#/signup
# Benoetigte Dienste im Dashboard: "Isochrones", "Matrix" und "Geocoding".
# Die Matrix liefert die Fahrzeiten im Tab "Orte pruefen" und ist dort ein
# eigener Dienst, nicht Teil der Isochronen.
OPENROUTESERVICE_API_KEY=

# Basis-URLs der Dienste. Standard ist api.heigit.org -- die alte Adresse
# api.openrouteservice.org wurde abgekuendigt (Abschaltung 24.08.2026).
# Nur setzen, wenn eine eigene Instanz verwendet werden soll.
OPENROUTESERVICE_ISOCHRONE_URL=
OPENROUTESERVICE_GEOCODING_URL=

# Photon-Instanz fuer die Adresssuche. Kein Schluessel noetig. Standard ist
# Komoots oeffentlicher Dienst; nur setzen, wenn eine eigene Instanz laufen
# soll -- Photon ist selbst betreibbar, der Index ist ein Downloadpaket.
PHOTON_URL=

# Overpass liefert die Orte in Schritt 3 (Studios, Maerkte, Bahnhoefe).
# Kein Schluessel noetig. Nur setzen, wenn eine andere Instanz oder ein eigener
# Server verwendet werden soll -- der oeffentliche Dienst ist gelegentlich
# ueberlastet und antwortet dann mit einer Fehlermeldung.
OVERPASS_URL=

# --- Karte ---------------------------------------------------------------
# Standard ist ein tokenfreier OSM-Raster-Style (siehe README).
# Nur setzen, wenn ein anderer Style verwendet werden soll.
MAP_STYLE_URL=
# Derselbe Anbieter, dunkler Stil. Gilt, sobald die Oberflaeche dunkel ist --
# eine helle Karte neben einer dunklen Seitenleiste blendet genau dort, wo man
# hinsieht. Wer MAP_STYLE_URL aendert, sollte auch hier etwas eintragen.
MAP_STYLE_URL_DARK=
MAP_TOKEN=

# --- Plattencache --------------------------------------------------------
# Provider-Antworten liegen auf der Platte statt nur im Arbeitsspeicher, damit
# ein Neustart das Kontingent nicht erneut kostet. Das Verzeichnis darf
# jederzeit geloescht werden -- es enthaelt nichts, was nicht wiederbeschaffbar
# waere.
CACHE_DIR=.cache

# Haltedauer je Typ. Die Vorgaben folgen daraus, wie schnell die jeweilige
# Wirklichkeit altert:
#   Isochronen  -- Strassennetze aendern sich in Monaten, ORS baut seinen
#                  Routing-Graphen periodisch neu.
#   Orte        -- Studios und Supermaerkte machen auf und zu.
#   Adressen    -- ein Ort bleibt, wo er ist.
#   Fahrzeiten  -- derselbe Routing-Graph wie die Isochronen, also derselbe Takt.
CACHE_TTL_ISOCHRONE_DAYS=7
CACHE_TTL_POI_HOURS=24
CACHE_TTL_GEOCODE_DAYS=30
CACHE_TTL_ROUTE_DAYS=7

# --- Server --------------------------------------------------------------
PORT=3001
